prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_memory
Description: Abseil memory library
URL: https://abseil.io/
Version: 20250512
Requires: absl_core_headers = 20250512, absl_meta = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
