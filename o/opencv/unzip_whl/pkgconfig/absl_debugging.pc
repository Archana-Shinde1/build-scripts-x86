prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_debugging
Description: Abseil debugging library
URL: https://abseil.io/
Version: 20250512
Requires: absl_stacktrace = 20250512, absl_leak_check = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
