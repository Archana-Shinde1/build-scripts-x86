prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_strerror
Description: Abseil strerror library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512, absl_errno_saver = 20250512
Libs: -L${libdir}  -labsl_strerror 
Cflags: -I${includedir} -DNOMINMAX
