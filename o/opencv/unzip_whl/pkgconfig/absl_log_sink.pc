prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_log_sink
Description: Abseil log_sink library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_log_entry = 20250512
Libs: -L${libdir}  -labsl_log_sink 
Cflags: -I${includedir} -DNOMINMAX
