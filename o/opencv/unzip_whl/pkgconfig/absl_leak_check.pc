prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_leak_check
Description: Abseil leak_check library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512
Libs: -L${libdir}  -labsl_leak_check 
Cflags: -I${includedir} -DNOMINMAX
