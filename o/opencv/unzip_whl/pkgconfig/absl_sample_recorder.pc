prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_sample_recorder
Description: Abseil sample_recorder library
URL: https://abseil.io/
Version: 20250512
Requires: absl_base = 20250512, absl_synchronization = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
