prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_poison
Description: Abseil poison library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512, absl_malloc_internal = 20250512
Libs: -L${libdir}  -labsl_poison 
Cflags: -I${includedir} -DNOMINMAX
