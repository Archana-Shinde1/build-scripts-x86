prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_log
Description: Abseil log library
URL: https://abseil.io/
Version: 20250512
Requires: absl_log_internal_log_impl = 20250512, absl_vlog_is_on = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
