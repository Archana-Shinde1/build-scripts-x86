URL: https://abseil.io/
Version: 20250512
Requires: absl_log_internal_conditions = 20250512, absl_log_internal_message = 20250512, absl_log_internal_strip = 20250512, absl_absl_vlog_is_on = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
