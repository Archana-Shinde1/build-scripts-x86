prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_log_structured
Description: Abseil log_structured library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512, absl_log_internal_structured = 20250512, absl_strings = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
