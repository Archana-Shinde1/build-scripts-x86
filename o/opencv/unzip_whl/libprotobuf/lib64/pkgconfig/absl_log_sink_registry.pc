prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_log_sink_registry
Description: Abseil log_sink_registry library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_log_sink = 20250512, absl_log_internal_log_sink_set = 20250512, absl_nullability = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
