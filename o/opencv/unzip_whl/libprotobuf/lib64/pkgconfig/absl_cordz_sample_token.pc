prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_cordz_sample_token
Description: Abseil cordz_sample_token library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_cordz_handle = 20250512, absl_cordz_info = 20250512
Libs: -L${libdir}  -labsl_cordz_sample_token 
Cflags: -I${includedir} -DNOMINMAX
