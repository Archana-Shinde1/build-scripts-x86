prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_log_entry
Description: Abseil log_entry library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512, absl_log_internal_config = 20250512, absl_log_severity = 20250512, absl_span = 20250512, absl_strings = 20250512, absl_time = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
