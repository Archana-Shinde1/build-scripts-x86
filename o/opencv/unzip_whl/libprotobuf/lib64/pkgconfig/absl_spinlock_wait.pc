prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_spinlock_wait
Description: Abseil spinlock_wait library
URL: https://abseil.io/
Version: 20250512
Requires: absl_base_internal = 20250512, absl_core_headers = 20250512, absl_errno_saver = 20250512
Libs: -L${libdir}  -labsl_spinlock_wait 
Cflags: -I${includedir} -DNOMINMAX
