prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_throw_delegate
Description: Abseil throw_delegate library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_raw_logging_internal = 20250512
Libs: -L${libdir}  -labsl_throw_delegate 
Cflags: -I${includedir} -DNOMINMAX
