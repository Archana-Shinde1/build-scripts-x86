prefix=/root/protobuf/local/libprotobuf
exec_prefix=${prefix}
libdir=/root/protobuf/local/libprotobuf/lib64
includedir=/root/protobuf/local/libprotobuf/include

Name: absl_str_format
Description: Abseil str_format library
URL: https://abseil.io/
Version: 20250512
Requires: absl_config = 20250512, absl_core_headers = 20250512, absl_nullability = 20250512, absl_span = 20250512, absl_str_format_internal = 20250512, absl_string_view = 20250512
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
